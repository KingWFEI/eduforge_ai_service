# Resource generation (paths are relative to the project unless explicitly overridden)
FRONTEND_SLIDES_VENDOR_DIR=app/third_party/frontend_slides
GENERATED_RESOURCE_DIR=generated_resources
PPT_HTML_TEMPLATE_DIR=app/third_party/frontend_slides
PPT_DEFAULT_SLIDE_COUNT=8
PPT_MAX_SLIDE_COUNT=12
PPT_DEFAULT_DENSITY_MODE=reading_first
PPT_DEFAULT_STYLE=blue-professional
PPT_PLAYWRIGHT_TIMEOUT_SECONDS=20
PPT_SIGNED_URL_EXPIRE_SECONDS=900
PPT_GENERATE_ALL_THUMBNAILS=false
PPT_ALLOW_EXTERNAL_IMAGES=false

VIDEO_SEARCH_ENABLED=true
VIDEO_SEARCH_PROVIDER=bilibili
VIDEO_SEARCH_TIMEOUT_SECONDS=8
VIDEO_SEARCH_CACHE_TTL_SECONDS=43200
VIDEO_SEARCH_MAX_RESULTS=20
VIDEO_SEARCH_RATE_LIMIT=0.5
VIDEO_MIN_MATCH_SCORE=0.45
VIDEO_MAX_RETRIES=2

MIND_MAP_MAX_DEPTH=4
MIND_MAP_MAX_CHILDREN=6
MIND_MAP_MAX_INTRA_RELATIONS=12
MIND_MAP_MAX_CROSS_RELATIONS=10
MIND_MAP_MAX_RELATED_CHAPTERS=5
MIND_MAP_MIN_RELATION_STRENGTH=0.55

RESOURCE_GENERATION_MAX_RETRIES=2
RESOURCE_GENERATION_TASK_TIMEOUT_SECONDS=300
